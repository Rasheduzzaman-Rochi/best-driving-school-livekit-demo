# Server-only credentials used by the connection endpoint.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud

# Optional. Leave unset when the endpoint is hosted by this application.
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=https://voice.example.com/api/connection-details
